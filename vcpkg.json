{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "glibre",
  "version-string": "0.0.0",
  "description": "No-code game engine",
  "homepage": "https://github.com/cjhowe/glibre",
  "supports": "osx & arm64",
  "dependencies": [
    "sdl3",
    "joltphysics",
    "meshoptimizer",
    "draco",
    "metal-cpp",
    "freeimage",
    "freetype",
    "fory",
    "imgui",
    "spdlog",
    "fmt",
    "xxhash",
    "blake3",
    "shader-slang",
    "eastl"
  ],
  "features": {
    "tests":  { "description": "Build Catch2 test suite",  "dependencies": ["catch2"] },
    "editor": { "description": "Build editor",             "dependencies": [] }
  },
  "default-features": ["tests", "editor"]
}
