// SPDX-License-Identifier: Apache-2.0
// data/schemas/example.fory
//
// Illustrative .fory schemas used in CI to exercise the glibre-foryc
// --emit=header codegen path (plan #220).
//
// These schemas cover the full range of builtin types so that CI
// confirms the complete mapping table and the conditional _builtins.hpp
// include path are both exercised:
//
//   Widget      — stdlib-only scalars (u32, f32, string, bool) + generics
//   Transform   — math types (vec3f, quatf) and entity handle
//                 triggers #include <glibre/types/_builtins.hpp>

// -------------------------------------------------------------------
// Widget — stdlib-scalars + all three generic forms
// -------------------------------------------------------------------

schema glibre.example.Widget {
  version 2
  since   "0.1.0"

  field id         : u32         tag 1  since 1
  field weight     : f32         tag 2  since 1
  field name       : string      tag 3  since 1
  field active     : bool        tag 4  since 1
  field score      : i64         tag 5  since 1
  field ratio      : f64         tag 6  since 1
  field flags      : u8          tag 7  since 1
  field count      : u16         tag 8  since 1
  field offset     : i32         tag 9  since 1
  field magnitude  : u64         tag 10 since 2
  field payload    : bytes       tag 11 since 2

  // Generics — one of each kind.
  field tags       : list<u32>          tag 12 since 2
  field metadata   : map<u32,string>    tag 13 since 2
  field nickname   : option<string>     tag 14 since 2
}

// -------------------------------------------------------------------
// Transform — math types + entity handle; exercises _builtins.hpp path
// -------------------------------------------------------------------

schema glibre.example.Transform {
  version 1
  since   "0.1.0"

  field translation : vec3f   tag 1  since 1
  field rotation    : quatf   tag 2  since 1
  field scale       : vec3f   tag 3  since 1
  field owner       : entity  tag 4  since 1
  field pivot       : vec2f   tag 5  since 1
  field bounds_min  : vec3i   tag 6  since 1
  field bounds_max  : vec3i   tag 7  since 1
  field color       : vec4f   tag 8  since 1
  field screen_pos  : vec2i   tag 9  since 1
  field blend       : vec4i   tag 10 since 1
}
