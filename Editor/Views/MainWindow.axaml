<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Editor.ViewModels"
        xmlns:views="using:Editor.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontBase}">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="Button.menuItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Fg1}" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="{StaticResource FontMd}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.menuItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Bg2}" />
    </Style>

    <Style Selector="Button.pill">
      <Setter Property="Background" Value="{StaticResource Bg1}" />
      <Setter Property="Foreground" Value="{StaticResource Fg1}" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}" />
      <Setter Property="BorderThickness" Value="0.5" />
      <Setter Property="FontSize" Value="{StaticResource FontMd}" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Bg2}" />
    </Style>

    <Style Selector="Border.pane">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="0.5" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.paneHeader">
      <Setter Property="Background" Value="{StaticResource PanelHi}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,0.5" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Border.paneHeader TextBlock.title">
      <Setter Property="FontSize" Value="{StaticResource FontMd}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Fg1}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ghostTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Fg2}" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="{StaticResource FontSm}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.ghostTab.active">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="{StaticResource Bg2}" />
    </Style>

    <Style Selector="TextBlock.row">
      <Setter Property="Foreground" Value="{StaticResource Fg1}" />
      <Setter Property="Padding" Value="20,3" />
      <Setter Property="FontSize" Value="{StaticResource FontMd}" />
    </Style>

    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="{StaticResource Accent}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="30,28,52,*,4,240" Margin="8">

    <!-- 1. Title bar -->
    <Border Grid.Row="0"
            Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="0.5"
            CornerRadius="10,10,0,0">
      <Grid>
        <TextBlock Text="{Binding WindowTitle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource FontMd}"
                   FontWeight="Medium"
                   Foreground="{StaticResource Fg2}" />
        <Canvas Width="16" Height="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="80,0,0,0">
          <Path Data="M8 1 L14 4 L14 12 L8 15 L2 12 L2 4 Z"
                Stroke="{StaticResource Fg1}"
                StrokeThickness="1.2"
                Fill="Transparent" />
          <Ellipse Width="4.4" Height="4.4"
                   Canvas.Left="5.8" Canvas.Top="5.8"
                   Fill="{StaticResource Fg1}" />
        </Canvas>
      </Grid>
    </Border>

    <!-- 2. Menu bar -->
    <Border Grid.Row="1"
            Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="0.5,0,0.5,0.5"
            Padding="6,0">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="menuItem" FontWeight="SemiBold" Content="glibre" />
        <Button Classes="menuItem" Content="File" />
        <Button Classes="menuItem" Content="Edit" />
        <Button Classes="menuItem" Content="Selection" />
        <Button Classes="menuItem" Content="View" />
        <Button Classes="menuItem" Content="Entity" />
        <Button Classes="menuItem" Content="Build" />
        <Button Classes="menuItem" Content="Window" />
        <Button Classes="menuItem" Content="Help" />
      </StackPanel>
    </Border>

    <!-- 3. Toolbar -->
    <Border Grid.Row="2"
            Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="0.5,0,0.5,0.5"
            Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="pill" Content="Select" />
          <Button Classes="pill" Content="Move" />
          <Button Classes="pill" Content="Rotate" />
          <Button Classes="pill" Content="Scale" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="pill" Content="▶  Play" />
          <Button Classes="pill" Content="⏸  Pause" />
          <Button Classes="pill" Content="⏭  Step" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="pill" Content="Layout: Default ▾" />
          <Button Classes="pill" Content="macOS — Universal ▾" />
          <Button Classes="pill" Content="Build" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 4. Main row: left | center | right -->
    <Grid Grid.Row="3" ColumnDefinitions="280,4,*,4,340" Margin="0,8,0,0">

      <!-- Left: Hierarchy -->
      <Border Grid.Column="0" Classes="pane">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Classes="paneHeader">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="title" Text="Hierarchy" />
              <TextBlock Grid.Column="1" Text="World"
                         Foreground="{StaticResource Fg3}"
                         FontSize="{StaticResource FontSm}"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ScrollViewer>
            <StackPanel Margin="0,6">
              <TextBlock Classes="row" Text="▾  World" />
              <TextBlock Classes="row" Text="    ▾  Environment" Padding="36,3" />
              <TextBlock Classes="row" Text="        ▸  Rock.Cluster.A" Padding="52,3"
                         Foreground="{StaticResource AccentHi}" />
              <TextBlock Classes="row" Text="        ▸  Rock.Cluster.B" Padding="52,3" />
              <TextBlock Classes="row" Text="    ▸  Lighting" Padding="36,3" />
              <TextBlock Classes="row" Text="    ▸  Cameras"  Padding="36,3" />
              <TextBlock Classes="row" Text="    ▸  Audio"    Padding="36,3" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />

      <!-- Center: viewport -->
      <Border Grid.Column="2" Classes="pane">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Classes="paneHeader">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Border Background="{StaticResource Bg2}" CornerRadius="4" Padding="8,2">
                  <TextBlock Text="Scene.glscene"
                             Foreground="{StaticResource Fg}"
                             FontSize="{StaticResource FontSm}" />
                </Border>
                <Border Background="Transparent" CornerRadius="4" Padding="8,2">
                  <TextBlock Text="Logic.glgraph"
                             Foreground="{StaticResource Fg2}"
                             FontSize="{StaticResource FontSm}" />
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="2"
                         Text="60 fps · 1.2 ms"
                         Foreground="{StaticResource Fg3}"
                         FontSize="{StaticResource FontSm}"
                         FontFamily="{StaticResource MonoFont}"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Background="{StaticResource Viewport}">
            <views:ViewportView />
          </Border>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Width="4" ResizeDirection="Columns" />

      <!-- Right: Inspector -->
      <Border Grid.Column="4" Classes="pane">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Classes="paneHeader">
            <TextBlock Classes="title" Text="Inspector" />
          </Border>
          <ScrollViewer>
            <StackPanel Margin="12,10" Spacing="10">
              <StackPanel Spacing="2">
                <TextBlock Text="Rock.Cluster.A"
                           FontSize="{StaticResource FontLg}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Fg}" />
                <TextBlock Text="World / Environment / Rock.Cluster.A"
                           FontSize="{StaticResource FontXs}"
                           Foreground="{StaticResource Fg3}" />
              </StackPanel>

              <Border Background="{StaticResource Bg1}" CornerRadius="6" Padding="10">
                <StackPanel Spacing="6">
                  <TextBlock Text="Transform"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource Fg1}"
                             FontSize="{StaticResource FontMd}" />
                  <Grid ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="4" ColumnSpacing="10">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Position"
                               Foreground="{StaticResource Fg2}"
                               FontSize="{StaticResource FontSm}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="0.00   1.20   -3.50"
                               Foreground="{StaticResource Fg}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontSm}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotation"
                               Foreground="{StaticResource Fg2}"
                               FontSize="{StaticResource FontSm}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="0    45    0"
                               Foreground="{StaticResource Fg}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontSm}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Scale"
                               Foreground="{StaticResource Fg2}"
                               FontSize="{StaticResource FontSm}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="1.00   1.00   1.00"
                               Foreground="{StaticResource Fg}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontSm}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="{StaticResource Bg1}" CornerRadius="6" Padding="10">
                <StackPanel Spacing="6">
                  <TextBlock Text="Mesh Renderer"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource Fg1}"
                             FontSize="{StaticResource FontMd}" />
                  <TextBlock Text="Material: Rock_Granite_01"
                             Foreground="{StaticResource Fg2}"
                             FontSize="{StaticResource FontSm}" />
                  <TextBlock Text="Shadows: Cast + Receive"
                             Foreground="{StaticResource Fg2}"
                             FontSize="{StaticResource FontSm}" />
                </StackPanel>
              </Border>

              <Button Classes="pill" Content="＋  Add Component"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- 5. Bottom resize handle -->
    <GridSplitter Grid.Row="4" Height="4" ResizeDirection="Rows"
                  HorizontalAlignment="Stretch" />

    <!-- 6. Bottom pane: Logs / Chat ghost tabs -->
    <Border Grid.Row="5" Classes="pane">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Classes="paneHeader">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
              <Button Classes="ghostTab active" Content="Logs" />
              <Button Classes="ghostTab" Content="Chat" />
              <Button Classes="ghostTab" Content="Timeline" />
              <Button Classes="ghostTab" Content="Signals" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="0 errors · 2 warnings"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Fg3}"
                       FontSize="{StaticResource FontSm}"
                       FontFamily="{StaticResource MonoFont}" />
          </Grid>
        </Border>
        <ScrollViewer>
          <StackPanel Margin="12,8" Spacing="3">
            <TextBlock Foreground="{StaticResource Fg2}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="{StaticResource FontSm}"
                       Text="[14:02:18] glibre · launching editor (Metal renderer)" />
            <TextBlock Foreground="{StaticResource Fg2}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="{StaticResource FontSm}"
                       Text="[14:02:18] scene  · loaded Scene.glscene (38 entities)" />
            <TextBlock Foreground="{StaticResource Warn}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="{StaticResource FontSm}"
                       Text="[14:02:19] warn   · Rock.Cluster.B missing lightmap UVs" />
            <TextBlock Foreground="{StaticResource Fg2}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="{StaticResource FontSm}"
                       Text="[14:02:20] gfx    · MTLDevice = Apple M-series, 60 fps locked" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </Grid>

</Window>
