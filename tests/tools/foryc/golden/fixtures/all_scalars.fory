// tests/tools/foryc/golden/fixtures/all_scalars.fory
//
// Golden fixture: exercises every builtin scalar type in the builtin_map.
// One field per builtin — verifies complete scalar coverage in emit_header.

schema test.AllScalars {
  version 1
  field a_u8     : u8     tag 1
  field b_u16    : u16    tag 2
  field c_u32    : u32    tag 3
  field d_u64    : u64    tag 4
  field e_i8     : i8     tag 5
  field f_i16    : i16    tag 6
  field g_i32    : i32    tag 7
  field h_i64    : i64    tag 8
  field i_f32    : f32    tag 9
  field j_f64    : f64    tag 10
  field k_bool   : bool   tag 11
  field l_vec2f  : vec2f  tag 12
  field m_vec3f  : vec3f  tag 13
  field n_vec4f  : vec4f  tag 14
  field o_vec2i  : vec2i  tag 15
  field p_vec3i  : vec3i  tag 16
  field q_vec4i  : vec4i  tag 17
  field r_quatf  : quatf  tag 18
  field s_entity : entity tag 19
  field t_string : string tag 20
  field u_bytes  : bytes  tag 21
}
