<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>GLI.Runtime</RootNamespace>
    <ApplicationId>us.cjhowe.glibre.Runtime</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Vulkan" Version="3.2.2" />
    <PackageReference Include="Vortice.ShaderCompiler" Version="1.9.0" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.512.0" />
  </ItemGroup>

  <Target Name="CreateMacAppBundle" AfterTargets="Build"
          Condition="'$([MSBuild]::IsOSPlatform(`OSX`))' == 'true'">
    <PropertyGroup>
      <AppBundleDir>$(OutDir)Glibre.app</AppBundleDir>
    </PropertyGroup>
    <RemoveDir Directories="$(AppBundleDir)" />
    <MakeDir Directories="$(AppBundleDir)/Contents/MacOS;$(AppBundleDir)/Contents/Resources" />
    <Copy SourceFiles="Info.plist" DestinationFolder="$(AppBundleDir)/Contents" />
    <ItemGroup>
      <_BundleFiles Include="$(OutDir)**/*"
                    Exclude="$(OutDir)Glibre.app/**;$(OutDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_BundleFiles)"
          DestinationFiles="@(_BundleFiles->'$(AppBundleDir)/Contents/MacOS/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
